FROM python:3.11-slim

# 位图页编辑（扫描件改字）依赖 onnxruntime + opencv，镜像会明显变大，
# 因此默认不装。需要时：docker build --build-arg INSTALL_RASTER=1 -f Dockerfile.api .
ARG INSTALL_RASTER=0

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PDF_EDITOR_DATA=/app/data

WORKDIR /app

# 系统依赖放在拷贝代码之前，代码一改就重下 100 MB 系统包是不必要的。
#   libGL —— rapidocr 会带入非 headless 的 opencv-python，导入时要它；
#   字体  —— slim 镜像里几乎没有字体，而重绘要从系统字体里挑最接近的一款，
#            没有字体位图编辑会直接报「找不到可用字体」。
#            Liberation 与 Arial/Times/Courier 度量兼容，Noto CJK 负责中日韩。
RUN addgroup --system app \
    && adduser --system --ingroup app app \
    && apt-get update \
    && apt-get install --yes --no-install-recommends gosu \
    && if [ "$INSTALL_RASTER" = "1" ]; then \
           apt-get install --yes --no-install-recommends \
               libgl1 libglib2.0-0 \
               fonts-liberation fonts-dejavu-core fonts-noto-core fonts-noto-cjk; \
       fi \
    && rm -rf /var/lib/apt/lists/*

COPY --chown=app:app apps/api /app
COPY scripts/docker-entrypoint-api.sh /usr/local/bin/docker-entrypoint-api
RUN if [ "$INSTALL_RASTER" = "1" ]; then \
        pip install --no-cache-dir ".[raster]"; \
    else \
        pip install --no-cache-dir .; \
    fi

RUN mkdir -p /app/data \
    && chown app:app /app/data \
    && chmod 0755 /usr/local/bin/docker-entrypoint-api

VOLUME ["/app/data"]
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/api/v1/health', timeout=3)"

ENTRYPOINT ["docker-entrypoint-api"]
CMD ["uvicorn","app.main:app","--host","0.0.0.0","--port","8000"]
